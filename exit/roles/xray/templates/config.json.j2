{
  "log": {
    "loglevel": "warning",
    "access": "none",
    "error": "{{ xray_log_dir }}/error.log"
  },
  "inbounds": [
    {
      "tag": "reality-in",
      "listen": "0.0.0.0",
      "port": {{ reality_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ vault_xray_client_uuid }}",
            "email": "edge-primary"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "{{ tr_ip }}",
          "minVersion": "1.2",
          "certificates": [
            {
              "certificateFile": "{{ xray_conf_dir }}/self.crt",
              "keyFile": "{{ xray_conf_dir }}/self.key"
            }
          ]
        }
      },
      "sniffing": {
        "enabled": {{ xray_sniffing | lower }},
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": false
      }
    },
    {
      "tag": "reality-alt-in",
      "listen": "0.0.0.0",
      "port": {{ reality_alt_port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ vault_xray_client_uuid }}",
            "email": "edge-failover"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "{{ tr_ip }}",
          "minVersion": "1.2",
          "certificates": [
            {
              "certificateFile": "{{ xray_conf_dir }}/self.crt",
              "keyFile": "{{ xray_conf_dir }}/self.key"
            }
          ]
        }
      },
      "sniffing": {
        "enabled": {{ xray_sniffing | lower }},
        "destOverride": ["http", "tls", "quic"]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": { "domainStrategy": "UseIP" }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": { "response": { "type": "http" } }
    }
  ],
  "dns": {
    "servers": ["1.1.1.1", "8.8.8.8", "localhost"],
    "queryStrategy": "UseIP"
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "direct"
      }
    ]
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 4,
        "connIdle": 300,
        "uplinkOnly": 2,
        "downlinkOnly": 5,
        "bufferSize": 4
      }
    },
    "system": {
      "statsInboundUplink": false,
      "statsInboundDownlink": false
    }
  }
}
